      "type": "object",
      "properties": {
        "weekId": { "type": "string" },
        "distributedAt": { "type": "string", "format": "date-time" },
        "winners": { "type": "array", "items": { "type": "string" } },
        "amountPerWinner": { "type": "number" }
      },
      "required": ["weekId", "distributedAt", "winners"]
    },
    "Bet": {
      "title": "Sports Bet",
      "description": "A parlay bet placed by a user in Bet Optimum.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user who placed the bet." },
        "selections": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "matchId": { "type": "string" },
              "prediction": { "type": "string", "enum": ["home", "draw", "away"] },
              "odds": { "type": "number" },
              "matchInfo": { "type": "string" }
            }
          }
        },
        "amount": { "type": "number", "description": "Stake amount." },
        "potentialWin": { "type": "number", "description": "Maximum possible payout." },
        "status": { "type": "string", "enum": ["pending", "won", "lost"] },
        "correctCount": { "type": "integer", "description": "Number of correct predictions." },
        "payout": { "type": "number", "description": "Actual amount paid out." },
        "createdAt": { "type": "string", "format": "date-time" },
        "settledAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "selections", "amount", "status", "createdAt"]
    },
    "RankRewardBenefit": {
      "title": "Rank Reward Benefit",
