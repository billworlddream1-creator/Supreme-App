rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          request.auth.token.email in ["billworlddream1@gmail.com", "supremeseller@gmail.com", "sunny@gmail.com", "supreme@gmail.com"] ||
          request.auth.uid == "eEofBFZ851bqqcAlOdmD3cmlUbp2" ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'mini-admin'])
        );
    }

    function isMasterAdmin() {
      return isAuthenticated() && request.auth.token.email == "billworlddream1@gmail.com";
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Users Collection
    match /users/{userId} {
      allow read, list: if true;
      allow create: if isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();

      match /cards/{cardId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Transactions Collection
    match /transactions/{txId} {
      allow read, list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Ads Collection
    match /ads/{adId} {
      allow read, list: if true;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Friendships Collection
    match /friendships/{friendshipId} {
      allow read, list: if isAuthenticated() && (resource.data.users.hasAny([request.auth.uid]) || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.users.hasAny([request.auth.uid]) || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.users.hasAny([request.auth.uid]) || isAdmin());
    }

    // Messages Collection
    match /messages/{messageId} {
      allow read, list: if isAuthenticated() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Communities Collection
    match /communities/{communityId} {
      allow read, list: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Subscriptions Collection
    match /subscriptions/{subId} {
      allow read, list: if isAuthenticated() && (resource.data.subscriberId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.subscriberId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Awards Collection
    match /awards/{awardId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.authorUid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'comments', 'shares']));
      allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // Products Collection
    match /products/{productId} {
      allow read, list: if true;
      allow create: if isAuthenticated() && (request.resource.data.sellerUid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.sellerUid == request.auth.uid && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'approvedAt', 'readyToListAt']))
      );
      allow delete: if isAuthenticated() && (resource.data.sellerUid == request.auth.uid || isAdmin());
    }

    // Market Dealer Profiles Collection
    match /market_dealer_profiles/{profileId} {
      allow read, list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verifiedAt', 'sincerityScore', 'adminNotes']));
      allow delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.buyerUid == request.auth.uid || resource.data.dealerUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.buyerUid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.dealerUid == request.auth.uid && request.resource.data.buyerUid == resource.data.buyerUid) ||
        (resource.data.buyerUid == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userMarkedReceived', 'status']) &&
         (request.resource.data.status in ['delivered', 'disputed']))
      );
      allow delete: if isAdmin();
    }

    // Mini Admins Collection
    match /mini_admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Game Sessions Collection
    match /game_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Weekly Engagement Collection
    match /weekly_engagement/{engagementId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reward Distributions Collection
    match /reward_distributions/{distId} {
      allow read, list: if isAuthenticated();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Bets Collection
    match /bets/{betId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Gift Cards Collection
    match /gift_cards/{cardId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Promote Tracking Collection
    match /promote_tracking/{trackingId} {
      allow read, list: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Rank Reward Benefits Collection
    match /rank_reward_benefits/{rewardId} {
      allow read, list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Treasure Investments Collection
    match /treasureInvestments/{invId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Supreme CMD - Security Threats
    match /security_threats/{threatId} {
      allow read, list: if isAdmin();
      allow create: if true; // Allow logging from anywhere, usually system-driven
      allow update, delete: if isAdmin();
    }

    // Supreme CMD - IP Blocks
    match /ip_blocks/{blockId} {
      allow read, list: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Supreme CMD - Feature Locks
    match /feature_locks/{lockId} {
      allow read, list: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Connectivity Logs Collection
    match /connectivity_logs/{logId} {
      allow read, list: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Admin Wallets
    match /admin_wallets/{walletId} {
      allow read, write: if isAuthenticated() && (
        request.auth.token.email in ["billworlddream1@gmail.com", "supremeseller@gmail.com", "sunny@gmail.com", "supreme@gmail.com"] ||
        isAdmin()
      );
    }

    // Admin Transactions
    match /admin_transactions/{txId} {
      allow read, write: if isAuthenticated() && (
        request.auth.token.email in ["billworlddream1@gmail.com", "supremeseller@gmail.com", "sunny@gmail.com", "supreme@gmail.com"] ||
        isAdmin()
      );
    }

    // Test Connection
    match /test/connection {
      allow read: if true;
    }
  }
}
